
# MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="montagehub"
MONGODB_LOGS_URI=""
MONGODB_LOGS_DB="montagehub_logs"

# NextAuth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# For multi-subdomain auth in production (example: .montagehub.ru)
NEXTAUTH_COOKIE_DOMAIN=""

# AI & Service API Keys
# These keys are required for the AI features and other services to work.
# IMPORTANT: These are used on the server-side only and should NOT be prefixed with NEXT_PUBLIC_.
OPENROUTER_API_KEY="your_openrouter_api_key"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_AUTH_EMAIL_DOMAIN="telegram.local"
TELEGRAM_BOT_SECRET_TOKEN=""
TELEGRAM_BOT_WEBHOOK_URL=""
# Bot mode: "polling" (local dev, default) or "webhook" (VDS production)
TELEGRAM_BOT_MODE="polling"
VK_AUTH_EMAIL_DOMAIN="vk.local"
VK_ID_CLIENT_ID=""
VK_ID_CLIENT_SECRET=""
VK_ID_REDIRECT_URI="http://localhost:3000/api/auth/callback/vk"
VK_BOT_ENABLED="false"
VK_GROUP_ID=""
VK_ACCESS_TOKEN=""
VK_CALLBACK_SECRET=""
VK_CONFIRMATION_TOKEN=""
VK_WEBHOOK_URL="http://localhost:3000/api/vk/webhook"
# Optional per-audience bot tokens/webhooks
TELEGRAM_BOT_TOKEN_USER=""
TELEGRAM_BOT_SECRET_TOKEN_USER=""
TELEGRAM_BOT_WEBHOOK_URL_USER=""
TELEGRAM_BOT_TOKEN_PARTNER=""
TELEGRAM_BOT_SECRET_TOKEN_PARTNER=""
TELEGRAM_BOT_WEBHOOK_URL_PARTNER=""
TELEGRAM_BOT_TOKEN_MANAGER=""
TELEGRAM_BOT_SECRET_TOKEN_MANAGER=""
TELEGRAM_BOT_WEBHOOK_URL_MANAGER=""
TELEGRAM_BOT_TOKEN_ADMIN=""
TELEGRAM_BOT_SECRET_TOKEN_ADMIN=""
TELEGRAM_BOT_WEBHOOK_URL_ADMIN=""
# Production example for Montage HUB:
# TELEGRAM_BOT_WEBHOOK_URL="https://montagehub.ru/api/telegram/webhook"
# TELEGRAM_BOT_WEBHOOK_URL_USER="https://lk.montagehub.ru/api/telegram/webhook/user"
# TELEGRAM_BOT_WEBHOOK_URL_PARTNER="https://partner.montagehub.ru/api/telegram/webhook/partner"
# TELEGRAM_BOT_WEBHOOK_URL_MANAGER="https://crm.montagehub.ru/api/telegram/webhook/manager"
# TELEGRAM_BOT_WEBHOOK_URL_ADMIN="https://admin.montagehub.ru/api/telegram/webhook/admin"
# NEXT_PUBLIC_TELEGRAM_WEBAPP_URL="https://lk.montagehub.ru"
# NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/<your_login_bot_username>"
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="<your_login_bot_username>"
QA_TEST_USER_EMAIL="qa@example.com"
QA_TEST_USER_PASSWORD="change-me"
QA_TEST_USER_PHONE="+79990000000"
QA_PROTECT_USER="true"
DADATA_API_KEY="your_dadata_api_key"
DADATA_API_SECRET="your_dadata_secret_key"
CLOUD_RU_API_KEY="your_cloud_ru_api_key"

# Passkey / WebAuthn
PASSKEY_ORIGIN="http://localhost:3000"
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="Montage HUB"
PASSKEY_TIMEOUT_MS="60000"
PASSKEY_CHALLENGE_TTL_MS="300000"
PASSKEY_USER_VERIFICATION="preferred"
PASSKEY_ATTESTATION="none"

# External QA / CI smoke
E2E_BASE_URL=""
E2E_USER_EMAIL=""
E2E_USER_PASSWORD=""
SMOKE_BASE_URL=""
SMOKE_DOMAINS=""
SMOKE_BROWSER_UPLOAD_FLOW="0"

# Application Settings
# These settings control various application behaviors.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_WEBAPP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/YourBot"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="YourBot"
SUPER_ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_REALTIME_MODE="manual"

# SMTP for password resets
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="Montage HUB <noreply@example.com>"
SMTP_ENABLED="false"

