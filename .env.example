
# MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="aismetchik"

# NextAuth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# For multi-subdomain auth in production (example: .aismetchik.ru)
NEXTAUTH_COOKIE_DOMAIN=""

# Optional: used by the migration script
FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/serviceAccount.json"

# AI & Service API Keys
# These keys are required for the AI features and other services to work.
# IMPORTANT: These are used on the server-side only and should NOT be prefixed with NEXT_PUBLIC_.
OPENROUTER_API_KEY="your_openrouter_api_key"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_SECRET_TOKEN=""
TELEGRAM_BOT_WEBHOOK_URL=""
# Optional per-audience bot tokens/webhooks
TELEGRAM_BOT_TOKEN_USER=""
TELEGRAM_BOT_SECRET_TOKEN_USER=""
TELEGRAM_BOT_WEBHOOK_URL_USER=""
TELEGRAM_BOT_TOKEN_PARTNER=""
TELEGRAM_BOT_SECRET_TOKEN_PARTNER=""
TELEGRAM_BOT_WEBHOOK_URL_PARTNER=""
TELEGRAM_BOT_TOKEN_MANAGER=""
TELEGRAM_BOT_SECRET_TOKEN_MANAGER=""
TELEGRAM_BOT_WEBHOOK_URL_MANAGER=""
TELEGRAM_BOT_TOKEN_ADMIN=""
TELEGRAM_BOT_SECRET_TOKEN_ADMIN=""
TELEGRAM_BOT_WEBHOOK_URL_ADMIN=""
DADATA_API_KEY="your_dadata_api_key"
DADATA_API_SECRET="your_dadata_secret_key"
CLOUD_RU_API_KEY="your_cloud_ru_api_key"


# Application Settings
# These settings control various application behaviors.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/YourBot"
SUPER_ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_REALTIME_MODE="manual"

# SMTP for password resets
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="AI Smetchik <noreply@example.com>"
SMTP_ENABLED="false"
