# Copy to deploy/.env.vds on the server
# Used by docker compose command:
# docker compose --env-file deploy/.env.vds -f deploy/docker-compose.vds.yml up -d --build

COMPOSE_PROJECT_NAME=ai-smetchik

# Optional profile:
# COMPOSE_PROFILES=with-mongo

# Public URLs for production runtime
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
AUTH_TRUST_HOST=true

# TLS itself is managed by GitHub Actions secrets:
# VDS_DOMAIN=your-domain.com
# LETSENCRYPT_EMAIL=ops@your-domain.com
