# Copy to deploy/.env.vds on the server
# Used by docker compose command:
# docker compose --env-file deploy/.env.vds -f deploy/docker-compose.vds.yml up -d --build

COMPOSE_PROJECT_NAME=ai-smetchik

# Optional profile:
# COMPOSE_PROFILES=with-mongo

# Public URLs for production runtime
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
AUTH_TRUST_HOST=true
NEXTAUTH_COOKIE_DOMAIN=.your-domain.com
# For AI Smetchik production:
# NEXTAUTH_URL=https://aismetchik.ru
# NEXT_PUBLIC_SITE_URL=https://aismetchik.ru
# NEXTAUTH_COOKIE_DOMAIN=.aismetchik.ru
# NEXT_PUBLIC_TELEGRAM_WEBAPP_URL=https://lk.aismetchik.ru

# Telegram (default + audience specific)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET_TOKEN=
TELEGRAM_BOT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN_USER=
TELEGRAM_BOT_SECRET_TOKEN_USER=
TELEGRAM_BOT_WEBHOOK_URL_USER=https://lk.your-domain.com/api/telegram/webhook/user
TELEGRAM_BOT_TOKEN_PARTNER=
TELEGRAM_BOT_SECRET_TOKEN_PARTNER=
TELEGRAM_BOT_WEBHOOK_URL_PARTNER=https://partner.your-domain.com/api/telegram/webhook/partner
TELEGRAM_BOT_TOKEN_MANAGER=
TELEGRAM_BOT_SECRET_TOKEN_MANAGER=
TELEGRAM_BOT_WEBHOOK_URL_MANAGER=https://crm.your-domain.com/api/telegram/webhook/manager
TELEGRAM_BOT_TOKEN_ADMIN=
TELEGRAM_BOT_SECRET_TOKEN_ADMIN=
TELEGRAM_BOT_WEBHOOK_URL_ADMIN=https://admin.your-domain.com/api/telegram/webhook/admin
# Concrete AI Smetchik webhook values:
# TELEGRAM_BOT_WEBHOOK_URL=https://aismetchik.ru/api/telegram/webhook
# TELEGRAM_BOT_WEBHOOK_URL_USER=https://lk.aismetchik.ru/api/telegram/webhook/user
# TELEGRAM_BOT_WEBHOOK_URL_PARTNER=https://partner.aismetchik.ru/api/telegram/webhook/partner
# TELEGRAM_BOT_WEBHOOK_URL_MANAGER=https://crm.aismetchik.ru/api/telegram/webhook/manager
# TELEGRAM_BOT_WEBHOOK_URL_ADMIN=https://admin.aismetchik.ru/api/telegram/webhook/admin
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/<your_login_bot_username>
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<your_login_bot_username>

# QA user for test automation
QA_TEST_USER_EMAIL=
QA_TEST_USER_PASSWORD=
QA_TEST_USER_PHONE=
QA_PROTECT_USER=true

# TLS itself is managed by GitHub Actions secrets:
# VDS_DOMAIN=your-domain.com
# LETSENCRYPT_EMAIL=ops@your-domain.com
